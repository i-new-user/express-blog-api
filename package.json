{
  "name": "backend",
  "version": "1.0.0",
  "description": "NestJS + CQRS + Mongoose REST API for hometask 16",
  "packageManager": "yarn@1.22.22",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck:h13": "tsc -p tsconfig.h13-test.json --noEmit",
    "typecheck:h14": "tsc -p tsconfig.h14-test.json --noEmit",
    "typecheck:h15": "tsc -p tsconfig.h14-test.json --noEmit",
    "typecheck:h16": "tsc -p tsconfig.h14-test.json --noEmit",
    "start": "node dist/main.js",
    "test": "cross-env NODE_ENV=test jest --runInBand tests/h14.e2e.test.ts",
    "test:h13": "cross-env NODE_ENV=test jest --runInBand tests/h13.e2e.test.ts",
    "test:h14": "cross-env NODE_ENV=test jest --runInBand tests/h14.e2e.test.ts",
    "test:h15": "cross-env NODE_ENV=test jest --runInBand tests/h14.e2e.test.ts",
    "test:h16": "cross-env NODE_ENV=test jest --runInBand tests/h14.e2e.test.ts",
    "test:legacy": "cross-env NODE_ENV=test jest --runInBand --testPathIgnorePatterns=h13.e2e.test.ts",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "email:test": "ts-node-dev src/test-email.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.2",
    "nodemailer": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "8.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "8.3.4",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
